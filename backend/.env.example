# ── Database (set by docker-compose, do not change) ──────────────────────────
DATABASE_URL=postgresql+asyncpg://oruser:orpassword@postgres:5432/or_tracking

# ── Security ──────────────────────────────────────────────────────────────────
# Change this to a long random string before going live
SECRET_KEY=change-me-to-a-long-random-secret

# ── Admin account (created on first run) ─────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Admin

# ── Tuning (optional, defaults shown) ────────────────────────────────────────
CONFIDENCE_THRESHOLD=0.75
CLEANING_ALERT_MINUTES=15
MAX_PTT_SECONDS=5
DEVICE_TOKEN_EXPIRE_DAYS=365
NURSE_TOKEN_EXPIRE_HOURS=12
